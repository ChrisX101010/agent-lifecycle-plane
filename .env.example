# Copy only for manual setup. Prefer ./bootstrap.sh, which creates .env
# and generates a random URL-safe PostgreSQL password without printing it.
ALP_POSTGRES_PASSWORD=

ALP_SECURITY_MODE=local
ALP_API_TOKEN=

ALP_MODEL_POLICY=local_only
ALP_MODEL_PROVIDER=ollama
ALP_MODEL_NAME=qwen3.5:4b
ALP_MODEL_BASE_URL=http://host.docker.internal:11434
ALP_MODEL_API_KEY=

ALP_WEB_ALLOWLIST=example.com,www.rfc-editor.org,rfc-editor.org
ALP_BEAM_HOST_PORT=8090
ALP_BEAM_AGENTS=
RUST_LOG=info
